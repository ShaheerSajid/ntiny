%% core2avl (LSU) — minimal-text block diagram. Detail in src/core2avl.tex.
flowchart LR
  classDef in   fill:#eef2ff,stroke:#3730a3,color:#1e1b4b;
  classDef out  fill:#eef2ff,stroke:#3730a3,color:#1e1b4b;
  classDef comb fill:#fef9c3,stroke:#a16207,color:#713f12;
  classDef reg  fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a;
  classDef fsm  fill:#dcfce7,stroke:#15803d,color:#14532d;
  classDef mux  fill:#e5e7eb,stroke:#374151,color:#111827;

  subgraph IN[in]
    direction TB
    OP[mem_op / width]:::in
    AD[addr_i]:::in
    WD[data2write_i]:::in
    RD[readdata_i]:::in
    ST[stall_i]:::in
  end

  MIS[misalign detect]:::comb
  FSM([FSM<br/>IDLE / SECOND]):::fsm
  L2[2nd-beat latch]:::reg
  BE[BE + addr]:::comb
  WSH[wdata shift]:::comb
  IWB[IWB ctrl latch]:::reg
  MUX{{beat mux}}:::mux
  EXT[read extract]:::comb

  subgraph OUT[out]
    direction TB
    A[address_o]:::out
    B[byteenable_o]:::out
    W[writedata_o]:::out
    RW[read_o / write_o]:::out
    DR[data2read_o]:::out
    MS[misalign_stall_o]:::out
  end

  AD --> MIS
  OP --> MIS
  MIS -->|crosses| FSM
  MIS --> BE
  FSM -->|state| MUX
  FSM --> L2
  ST -. freeze .-> IWB
  ST -. gate .-> FSM
  WD --> WSH
  BE --> MUX
  MUX --> A
  MUX --> B
  MUX --> RW
  WSH --> W
  RD --> EXT
  IWB -. be_iwb .-> EXT
  EXT --> DR
  MIS --> MS
